// ════ hero counter ════
(()=>{
const M=DATA.counter;
setCardTitle('counter-title',M.title,'counter');
document.getElementById('counter-sub').textContent=M.sub;
const DUR=2600;let gen=0;
onShow('counter',()=>{
  const g=echarts.init(document.getElementById('counter'));
  g.clear();gen++;const my=gen;
  g.setOption({
    animationDuration:DUR,animationEasing:'cubicOut',tooltip:{show:false},
    grid:{left:14,right:20,top:64,bottom:24},
    xAxis:{type:'category',data:M.months,boundaryGap:false,
      axisLine:{show:false},axisTick:{show:false},splitLine:{show:false},
      axisLabel:{color:'#B9C9D7',fontSize:9,fontWeight:600,interval:11,formatter:v=>v.slice(2,4)+' 年'}},
    yAxis:{show:false,max:M.cum[M.cum.length-1]*1.06},
    series:[{type:'line',data:M.cum,smooth:.2,symbol:'none',
      lineStyle:{color:INK,width:2.6},
      areaStyle:{color:{type:'linear',x:0,y:0,x2:0,y2:1,
        colorStops:[{offset:0,color:'rgba(29,61,91,.14)'},{offset:1,color:'rgba(29,61,91,0)'}]}}}],
  });
  const t0=performance.now();
  const tick=()=>{
    if(my!==gen)return;
    const p=Math.min(1,(performance.now()-t0)/DUR);
    const eased=1-Math.pow(1-p,3);
    const val=(M.total*eased/10000).toFixed(0);
    g.setOption({graphic:[{id:'kpi',type:'group',left:16,top:8,children:[
      {type:'text',style:{text:val+' 万步',font:'800 32px Inter',fill:INK}},
      {type:'text',style:{text:'五年累计 · 2021.06 – 2026.09',y:38,font:'600 10px Inter, PingFang SC',fill:'#5E7F9B'}},
    ]}]});
    if(p<1)requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
});
})();

// ════ 日步数（可切 7/30）════
(()=>{
const M=DATA.last30,W=DATA.w30.steps;
setCardTitle('last30-title',M.title,'last30');
document.getElementById('last30-sub').textContent=M.sub;
renderers['last30']=n=>drawSteps(n);
function drawSteps(n){
  const svg=document.getElementById('last30');
  svg.innerHTML='';
  const vals=W.vals.slice(-n),wk=W.weekend.slice(-n),lab=W.labels.slice(-n);
  const N=vals.length,max=Math.max(...vals);
  const x=d=>30+d*(340/Math.max(1,N-1)),base=262,map=v=>base-(v/max)*205;
  for(let d=0;d<N;d++)
    el(svg,'line',{x1:x(d),y1:base,x2:x(d),y2:base-7,stroke:'#D0DAE3','stroke-width':.6,class:'fade'});
  el(svg,'line',{x1:24,y1:base,x2:376,y2:base,stroke:GRID,'stroke-width':.8});
  const top=[];
  for(const d of [...vals.keys()].sort((a,b)=>vals[b]-vals[a])){
    if(top.every(t=>Math.abs(t-d)>=Math.ceil(N/8)))top.push(d);
    if(top.length===2)break;
  }
  const pts=vals.map((v,d)=>`${x(d)} ${map(v)}`).join(' L ');
  el(svg,'path',{d:'M'+pts,fill:'none',stroke:INK,'stroke-width':1,pathLength:1,class:'draw'});
  vals.forEach((v,d)=>{
    const weekend=wk[d],big=top.includes(d);
    const dot=el(svg,'circle',{cx:x(d),cy:map(v),r:big?4.2:2.1,
      fill:weekend?PAPER:INK,stroke:INK,'stroke-width':weekend?1:0,class:'pop',
      style:`animation-delay:${.2+d*.03}s`});
    tip(dot,`${lab[d]} — ${Math.round(v).toLocaleString()} 步`);
    if(big)txt(svg,{x:x(d),y:map(v)-11,'font-size':9.5,'font-weight':800,fill:INK,'text-anchor':'middle',
      style:`paint-order:stroke;stroke:${PAPER};stroke-width:3px`,class:'fade'},(v/1000).toFixed(1)+'k');
  });
  [0,Math.floor((N-1)/2),N-1].forEach(d=>
    txt(svg,{x:x(d),y:base+18,'font-size':7.5,'font-weight':600,fill:MUTED,'text-anchor':'middle',class:'fade'},lab[d]));
  txt(svg,{x:200,y:306,'font-size':7,'font-weight':600,fill:'#A6B6C4','text-anchor':'middle','letter-spacing':'.12em'},
    `ONE DOT = ONE DAY · HOLLOW = WEEKEND · ${lab[0]} – ${lab[N-1]}`);
}
obsReveal('last30',()=>drawSteps(30));
})();

