  el(svg,'rect',{x:24,y:y60,width:352,height:y40-y60,fill:'#E6EBEF',rx:8});
  txt(svg,{x:372,y:y60-4,'font-size':8,'font-weight':600,fill:MUTED,'text-anchor':'end'},'60');
  txt(svg,{x:372,y:y40+10,'font-size':8,'font-weight':600,fill:MUTED,'text-anchor':'end'},'40');
  const pts=vals.map((v,i)=>`${x(i)} ${map(v)}`).join(' L ');
  el(svg,'path',{d:'M'+pts,fill:'none',stroke:'#5E7F9B','stroke-width':.8,'stroke-dasharray':'3 3'});
  let lo=0,hi=0;
  vals.forEach((v,i)=>{if(v<vals[lo])lo=i;if(v>vals[hi])hi=i;});
  vals.forEach((v,i)=>{
    const big=N>4&&(i===lo||i===hi);
    const dot=el(svg,'circle',{cx:x(i),cy:map(v),r:big?4.2:2.6,fill:INK,class:'pop'});
    tip(dot,`${lab[i]} — ${v} ms`);
    if(big)txt(svg,{x:x(i),y:map(v)-11,'font-size':9.5,'font-weight':800,fill:INK,'text-anchor':'middle',
      style:`paint-order:stroke;stroke:${PAPER};stroke-width:3px`,class:'fade'},v);
  });
  lab.forEach((l,i)=>{
    if(i%Math.ceil(N/5)===0)txt(svg,{x:x(i),y:224,'font-size':7.5,'font-weight':600,fill:MUTED,'text-anchor':'middle'},l);
  });
  txt(svg,{x:30,y:24,'font-size':7,'font-weight':600,fill:'#A6B6C4','letter-spacing':'.12em'},
    'GREY BAND = COMMON HEALTHY RANGE 40–60 MS');
}
renderers['hrvchart']=n=>draw(n);
obsReveal('hrvchart',()=>draw(30));
})();

