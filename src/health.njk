function setCardTitle(id,text,glossKey){
  const h=document.getElementById(id);
  h.textContent=text;
  h.className='tip';
  const mk=document.createElement('i');mk.className='mk';mk.textContent='ⓘ';
  const g=document.createElement('span');g.className='gloss';g.innerHTML=GLOSS[glossKey]||'';
  h.appendChild(mk);h.appendChild(g);
  h.addEventListener('click',e=>{e.stopPropagation();h.classList.toggle('open')});
}

// ── 00 昨日数据 ──
(()=>{
const Y=DATA.yday,M=Y.metrics;
const fmtN=n=>n==null?'—':Math.round(n).toLocaleString('en-US');
const st=M.steps,ratio=st.b?st.v/st.b:0;
setCardTitle('yday-title',`昨日走出 ${fmtN(st.v)} 步${st.b?`，是三十天均值的 ${ratio.toFixed(1)} 倍`:''}`,'yday');
document.getElementById('yday-sub').textContent=
  `${Y.date} · ${Y.weekday} · 每根柱 = 该小时步数 · 悬停看小时明细 · 导出于 ${Y.exported}`;
// 小时步数柱
obsReveal('yday-hours',n=>{
  const H=Y.hours,mx=Math.max(...H),W=760,pad=10,y0=142,yT=38;
  if(mx>0){
    [[mx,1],[mx/2,.5]].forEach(([v])=>{
      const yy=y0-(v/mx)*(y0-yT);
      el(n,'line',{x1:pad,x2:W-pad,y1:yy,y2:yy,stroke:GRID,'stroke-dasharray':'2 4','stroke-width':1});
      txt(n,{x:W-pad-2,y:yy-3,'text-anchor':'end','font-size':8,fill:MUTED,'font-weight':600},
        v>=1000?(Math.round(v/100)/10)+'k':Math.round(v)+'');
    });
  }
  const slot=(W-pad*2)/24,bw=Math.min(17,slot*.62);
  H.forEach((v,i)=>{
    const cx=pad+slot*(i+.5),h=mx>0?(v/mx)*(y0-yT):0;
    const r=v>0?el(n,'rect',{x:cx-bw/2,y:y0-h,width:bw,height:Math.max(h,3),rx:Math.min(4,bw/2),fill:INK})
              :el(n,'rect',{x:cx-1.5,y:y0-3,width:3,height:3,rx:1.5,fill:GRID});
    tip(r,`${String(i).padStart(2,'0')}:00–${String(i+1).padStart(2,'0')}:00 · ${Math.round(v).toLocaleString('en-US')} 步`);
    r.classList.add('pop');r.style.animationDelay=(i*38)+'ms';
  });
  [0,6,12,18,23].forEach(hh=>{
    txt(n,{x:pad+slot*(hh+.5),y:y0+14,'text-anchor':'middle','font-size':8.5,fill:MUTED,'font-weight':600},
      String(hh).padStart(2,'0'));
  });
  const pk=Y.peak_hour,px=pad+slot*(pk+.5),ph=(H[pk]/mx)*(y0-yT);
  txt(n,{x:px,y:y0-ph-10,'text-anchor':'middle','font-size':10,fill:INK,'font-weight':800},
    `${Math.round(H[pk]).toLocaleString('en-US')} 步`);
  el(n,'line',{x1:pad,x2:W-pad,y1:y0,y2:y0,stroke:'#C6D3DE','stroke-width':1.5});
});
// 全指标瓷板（首屏内容，直接渲染——空容器高 0 会卡死 IntersectionObserver 门控）
{
const TILES=[['distance','步行距离'],['flights','爬楼'],['exercise','锻炼'],['stand','站立'],['daylight','日照'],
  ['active','活动能量'],['total_burn','总消耗'],['sleep','睡眠·前夜'],['rhr','静息心率'],
  ['hr_range','心率区间'],['spo2','血氧'],['hrv','HRV'],['resp','呼吸'],['headphone','耳机音量']];
const n=document.getElementById('yday-tiles');
n.innerHTML=TILES.map(([k,lab])=>{
    const t=M[k];
    const v=typeof t.v!=='number'?String(t.v??'—'):
      t.v<100?String(Math.round(t.v*10)/10):Math.round(t.v).toLocaleString('en-US');
    let d='—';
    if(t.v!=null&&t.b){
      const p=Math.round((t.v-t.b)/t.b*100);
      d=Math.abs(p)<5?'≈均值':(p>0?'↑ ':'↓ ')+Math.abs(p)+'%';
    }
    const hot=t.v!=null&&t.b&&Math.abs(t.v-t.b)/t.b>=0.3;
    return `<div class="ytile"><div class="l">${lab}</div><div class="v">${v}<i>${t.unit}</i></div><div class="d${hot?' hot':''}">${d}</div></div>`;
  }).join('');
  n.classList.add('fade');
}
})();

// ── 窗口切换组件 ──
const renderers={};
function buildToggles(){
  document.querySelectorAll('.tg').forEach(tg=>{
    const target=tg.dataset.for;
    const modes=target==='tdee'?[7,30,0]:target==='c_audio'?[30,0]:[7,30];
    const names={7:'近7天',30:'近30天',0:target==='c_audio'?'年度':'4年月均'};
    let html='';
    modes.forEach((m,i)=>{html+=`<button data-n="${m}"${i===modes.length-1?' class="on"':''}>${names[m]}</button>`});
    tg.innerHTML=html;
    tg.querySelectorAll('button').forEach(btn=>{
      btn.addEventListener('click',()=>{
        tg.querySelectorAll('button').forEach(b=>b.classList.remove('on'));
        btn.classList.add('on');
        if(renderers[target])renderers[target](+btn.dataset.n);
      });
    });
  });
}

