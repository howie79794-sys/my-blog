// ════ 睡眠堆叠梯（可切）════
(()=>{
const M=DATA.sleep,W=DATA.w30.sleep;
setCardTitle('sleep-title',M.title,'sleep');
document.getElementById('sleep-sub').textContent=M.sub;
function draw(n){
  const svg=document.getElementById('sleep14');
  svg.innerHTML='';
  const deep=W.deep.slice(-n),rem=W.rem.slice(-n),core=W.core.slice(-n),lab=W.labels.slice(-n);
  const N=lab.length;
  const x0=i=>52+i*((N>8?360:300)/(N)),base=262,step=4.0,HW=11;
  const SHADE=['#C6D3DE','#5E7F9B',INK];
  const SEG=['CORE','REM','DEEP'];
  const SEGS=[core,rem,deep];
  lab.forEach((name,i)=>{
    const x=x0(i);let k0=0;
    SEGS.forEach((arr,si)=>{
      const rungs=Math.round(arr[i]*4);
      for(let k=0;k<rungs;k++){
        const y=base-(k0+k+si)*step,w=HW-1.4+rnd(k+1,i*3+si+2)*2.8;
        el(svg,'line',{x1:x-w,y1:y,x2:x+w,y2:y,stroke:SHADE[si],'stroke-width':1,
          opacity:.6+rnd(k+2,i+si+4)*.4,class:'fade'});
      }
      if(rungs>0&&N<=12){
        const midY=base-(k0+rungs/2+si)*step;
        const lb=txt(svg,{x:x+HW+6,y:midY+2.5,'font-size':7.5,'font-weight':800,
          fill:si===0?'#5E7F9B':SHADE[si],class:'fade'},arr[i].toFixed(1));
        tip(lb,`${name}夜 ${SEG[si]} — ${arr[i].toFixed(1)}h`);
      }
      k0+=rungs;
    });
    const total=core[i]+rem[i]+deep[i];
    txt(svg,{x,y:base-(k0+2)*step-8,'font-size':10,'font-weight':800,fill:INK,'text-anchor':'middle',class:'fade'},total.toFixed(1));
    txt(svg,{x,y:base+18,'font-size':7.5,'font-weight':700,fill:MUTED,'text-anchor':'middle','letter-spacing':'.06em',class:'fade'},name);
  });
  el(svg,'line',{x1:36,y1:base+4,x2:364,y2:base+4,stroke:GRID,'stroke-width':.8});
  txt(svg,{x:200,y:306,'font-size':7,'font-weight':600,fill:'#A6B6C4','text-anchor':'middle','letter-spacing':'.12em'},
    'ONE RUNG = 15 MIN · DARKEST = DEEP · TOP = 总时长(h)');
}
renderers['sleep14']=n=>draw(n);
obsReveal('sleep14',()=>draw(30));
})();

// ════ TDEE（ECharts 可切 7/30/4年月均）════
(()=>{
const M=DATA.tdee,W=DATA.w30.tdee;
setCardTitle('tdee-title',M.title,'tdee');
document.getElementById('tdee-sub').textContent=M.sub;
let g=null;
function monthly(){
  g.clear();
  g.setOption({
    animationDuration:900,animationEasing:'quarticOut',
    tooltip:{trigger:'axis',backgroundColor:'#1D3D5B',borderWidth:0,
      textStyle:{color:'#F0EFEB',fontSize:11,fontFamily:'Inter, PingFang SC'},
      valueFormatter:v=>Math.round(v)+' kcal'},
    grid:{left:52,right:20,top:20,bottom:26},
    xAxis:{type:'category',data:M.months,boundaryGap:false,
      axisLine:{show:false},axisTick:{show:false},splitLine:{show:false},
      axisLabel:{color:'#B9C9D7',fontSize:9,fontWeight:600,interval:11,formatter:v=>v.slice(2,4)+'年'}},
    yAxis:{splitLine:{lineStyle:{color:'#E6EBEF'}},axisLabel:{color:'#5E7F9B',fontSize:9.5}},
    series:[
      {name:'基础代谢',type:'line',stack:'tdee',data:M.basal,symbol:'none',smooth:.2,
       lineStyle:{color:'#5E7F9B',width:1},areaStyle:{color:'rgba(94,127,155,.28)'}},
      {name:'活动消耗',type:'line',stack:'tdee',data:M.active,symbol:'none',smooth:.2,
       lineStyle:{color:INK,width:1.4},areaStyle:{color:'rgba(29,61,91,.10)'},
       markLine:{silent:true,symbol:'none',lineStyle:{color:INK,type:'dashed',width:1},
         label:{formatter:'1,750',color:'#5E7F9B',fontSize:9,position:'insideEndTop'},
         data:[{yAxis:M.target}]}},
    ],
  });
}
function daily(n){
  g.clear();
  const lab=W.labels.slice(-n),ba=W.basal.slice(-n),ac=W.active.slice(-n);
  const tot=ba.map((v,i)=>v+ac[i]);
  g.setOption({
    animationDuration:700,animationEasing:'quarticOut',
    tooltip:{trigger:'axis',backgroundColor:'#1D3D5B',borderWidth:0,
      textStyle:{color:'#F0EFEB',fontSize:11,fontFamily:'Inter, PingFang SC'}},
    grid:{left:52,right:20,top:20,bottom:26},
    xAxis:{type:'category',data:lab,
      axisLine:{show:false},axisTick:{show:false},splitLine:{show:false},
      axisLabel:{color:'#B9C9D7',fontSize:9,fontWeight:600,interval:Math.max(0,Math.floor(lab.length/7)-1)}},
    yAxis:{splitLine:{lineStyle:{color:'#E6EBEF'}},axisLabel:{color:'#5E7F9B',fontSize:9.5}},
    series:[
      {name:'基础',type:'bar',stack:'d',data:ba,barWidth:'55%',
       itemStyle:{color:'#5E7F9B',borderRadius:[0,0,3,3]}},
      {name:'活动',type:'bar',stack:'d',data:ac,
       itemStyle:{color:INK,borderRadius:[3,3,0,0]},
       markLine:{silent:true,symbol:'none',lineStyle:{color:INK,type:'dashed',width:1},
         label:{formatter:'1,750',color:'#5E7F9B',fontSize:9,position:'insideEndTop'},
         data:[{yAxis:M.target}]}},
      {name:'合计',type:'line',data:tot,symbol:'circle',symbolSize:4,
       lineStyle:{color:INK,width:1.2},itemStyle:{color:INK}},
    ],
  });
}
renderers['tdee']=n=>{if(!g)return;n===0?monthly():daily(n)};
onShow('tdee',()=>{
  g=echarts.init(document.getElementById('tdee'));
  monthly();
  addEventListener('resize',()=>g&&g.resize());
});
})();

// ════ 听力（可切 30天日线/年度）════
(()=>{
const M=DATA.audio,W=DATA.w30.audio;
setCardTitle('audio-title',M.title,'audio');
document.getElementById('audio-sub').textContent=M.sub;
let chart=null;
const maxYear=Math.max(...M.vals);
function yearly(){
  const data={labels:M.labels.map(y=>y+' 年'),
    datasets:[{data:M.vals,
      backgroundColor:M.vals.map(v=>v===maxYear?INK:'#B9C9D7'),
      borderRadius:{topLeft:99,topRight:99},borderSkipped:false,barPercentage:.52}]};
  if(chart){chart.options.plugins.topValues=true;chart.data=data;chart.update();return}
  chart=new Chart(document.getElementById('c_audio'),{
    type:'bar',data,
    options:{
      maintainAspectRatio:false,indexAxis:'x',
      animation:{duration:900,easing:'easeOutQuart',delay:c=>c.type==='data'?c.dataIndex*110:0},
      plugins:{tooltip:{callbacks:{label:i=>i.raw+' dB(A)'}}},
      scales:{
        x:{grid:{display:false},border:{display:false},ticks:{padding:8,font:{size:9,weight:600}}},
        y:{display:false,suggestedMax:maxYear+4},
      },
    },
    plugins:[{
      id:'topValues',
      afterDatasetsDraw(ch){
        const {ctx}=ch;
        ch.getDatasetMeta(0).data.forEach((bar,i)=>{
          ctx.save();ctx.font='700 13px Inter';ctx.fillStyle=INK;ctx.textAlign='center';
          ctx.fillText(ch.data.datasets[0].data[i]+' dB',bar.x,bar.y-10);ctx.restore();
        });
      },
    }],
  });
}
function daily(){
  const vals=W.vals.slice(-30),lab=W.labels.slice(-30);
  const data={labels:lab,
    datasets:[{data:vals,backgroundColor:vals.map(v=>v>=80?INK:'#B9C9D7'),
      borderRadius:3,borderSkipped:false,barPercentage:.75,categoryPercentage:.9}]};
  if(chart){chart.options.plugins.topValues=false;chart.data=data;chart.update();return}
  chart=new Chart(document.getElementById('c_audio'),{type:'bar',data,
    options:{maintainAspectRatio:false,
      plugins:{tooltip:{callbacks:{label:i=>i.raw+' dB(A)'}}},
      scales:{
        x:{grid:{display:false},border:{display:false},ticks:{font:{size:8},maxRotation:0,autoSkip:true,maxTicksLimit:10}},
        y:{grid:{display:false},border:{display:false},suggestedMin:40,suggestedMax:85,
           ticks:{padding:8,maxTicksLimit:5,callback:v=>v+' dB',font:{size:9}}},
      }}});
  yearly();
}
renderers['c_audio']=n=>{n===0?yearly():daily()};
onShow('c_audio',()=>yearly());
})();

