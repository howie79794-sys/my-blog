<style>
  /* 健康页全宽：覆盖博客 .main 的 780px 内容栏 */
  .main { max-width: none; padding: 74px 0 40px; }
</style>
<div class="hdb">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  .hdb{--bg:#F0EFEB;--ink:#1D3D5B;--muted:#5E7F9B;--faint:#B9C9D7;--grid:#DEE5EB;--zone:#E7EAEE}
  .hdb{background:var(--bg);font-family:'Inter','PingFang SC','Hiragino Sans GB',sans-serif;color:var(--ink);padding:40px 24px;-webkit-font-smoothing:antialiased}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1100px;margin:0 auto}
  @media (max-width:720px){.grid2{grid-template-columns:1fr}.hdb{padding:24px 10px}}
  .card{background:var(--bg);border-radius:24px;padding:26px 26px 18px;min-width:0;position:relative}
  .card.wide{grid-column:1/-1}
  h2{font-weight:700;font-size:16.5px;letter-spacing:-.02em;margin-bottom:3px}
  .sub{font-size:11.5px;color:var(--muted);margin-bottom:14px;padding-right:130px}
  @media (max-width:720px){.sub{padding-right:0}}
  .src{font-size:9.5px;color:var(--faint);margin-top:10px;letter-spacing:.08em;font-weight:500}
  .ch{height:320px}
  .wrap{position:relative;height:320px}
  .hdb svg{width:100%;height:auto;max-height:330px;display:block;margin:0 auto}
  .hdb svg text{font-family:'Inter','PingFang SC',sans-serif}
  .pop{transform-box:fill-box;transform-origin:center;animation:pop .5s cubic-bezier(.2,.7,.3,1.3) both}
  @keyframes pop{from{transform:scale(0)}to{transform:none}}
  .fade{animation:fade .9s ease both}
  @keyframes fade{from{opacity:0}}
  .draw{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1s cubic-bezier(.4,0,.2,1) both}
  .draw2{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.6s cubic-bezier(.4,0,.2,1) both}
  @keyframes draw{to{stroke-dashoffset:0}}
  .pagehead{max-width:1100px;margin:0 auto 4px;padding:0 4px}
  .pagehead h1{font-size:22px;letter-spacing:-.02em;font-weight:800}
  .pagehead p{font-size:12px;color:#5E7F9B;margin-top:5px;line-height:1.7}
  .badge{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.08em;
    padding:3px 10px;border-radius:99px;margin-bottom:10px;border:1.5px solid #1D3D5B;color:#1D3D5B}
  .zone{background:var(--zone);border-radius:28px;padding:22px 18px 10px;margin:0 auto 26px;max-width:1138px}
  .zone .zh{display:flex;align-items:baseline;gap:12px;padding:2px 10px 14px}
  .zone .zh b{font-size:24px;font-weight:800;color:#D3D1C9;letter-spacing:-.02em}
  .zone .zh h3{font-size:12px;font-weight:800;letter-spacing:.16em;color:#6E6D67}
  .zone .zh .rule{flex:1;border-top:1px solid #D5D3CB;transform:translateY(-4px)}
  .zone .grid2{max-width:none;margin:0;padding:0 2px}
  .tip{position:relative;cursor:help;display:inline-block;border-bottom:1px dashed #A6B6C4;max-width:100%}
  .tip .mk{font-style:normal;font-size:11px;color:#A6B6C4;margin-left:4px;vertical-align:1px}
  .tip .gloss{display:none;position:absolute;left:0;top:calc(100% + 8px);z-index:50;width:min(300px,80vw);
    background:#1D3D5B;color:#F0EFEB;border-radius:14px;padding:12px 14px;font-size:11px;font-weight:500;
    line-height:1.75;letter-spacing:0;box-shadow:0 8px 28px rgba(29,61,91,.22)}
  .tip .gloss b{color:#fff;font-weight:700}
  .tip .gloss::before{content:'';position:absolute;left:16px;top:-4px;width:8px;height:8px;background:#1D3D5B;
    transform:rotate(45deg)}
  .tip:hover .gloss,.tip.open .gloss{display:block}
  .tg{position:absolute;top:22px;right:22px;display:flex;border:1px solid #D0DAE3;border-radius:99px;
    overflow:hidden;background:rgba(240,239,235,.9);z-index:10}
  .tg button{font-family:inherit;font-size:10px;font-weight:700;padding:5px 11px;background:transparent;
    border:0;color:#5E7F9B;cursor:pointer;letter-spacing:.02em}
  .tg button.on{background:#1D3D5B;color:#F0EFEB}
  .strip{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;padding:6px 4px 2px}
  @media (max-width:720px){.strip{grid-template-columns:repeat(3,1fr)}}
  .stat b{display:block;font-size:21px;font-weight:800;letter-spacing:-.02em}
  .stat span{font-size:9px;color:#5E7F9B;letter-spacing:.08em;font-weight:600}
  .gaitrow{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:4px 0 10px}
  @media (max-width:720px){.gaitrow{grid-template-columns:repeat(2,1fr)}}
  .gait b{display:block;font-size:19px;font-weight:800;letter-spacing:-.02em}
  .gait b i{font-style:normal;font-size:10px;font-weight:600;color:#5E7F9B;margin-left:3px}
  .gait span{font-size:9px;color:#5E7F9B;letter-spacing:.06em;font-weight:600}
  .ytiles{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
  @media (max-width:1000px){.ytiles{grid-template-columns:repeat(5,1fr)}}
  @media (max-width:720px){.ytiles{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:520px){.ytiles{grid-template-columns:repeat(3,1fr)}}
  .ytile{min-width:0;background:#EEF1F4;border-radius:14px;padding:10px 10px 8px}
  .ytile .l{font-size:9px;font-weight:600;letter-spacing:.05em;color:#5E7F9B;white-space:nowrap}
  .ytile .v{font-size:16px;font-weight:800;color:#1D3D5B;letter-spacing:-.02em;margin-top:4px;white-space:nowrap}
  .ytile .v i{font-style:normal;font-size:9px;font-weight:600;color:#5E7F9B;margin-left:2px}
  .ytile .d{font-size:9px;font-weight:600;color:#5E7F9B;margin-top:3px}
  .ytile .d.hot{color:#1D3D5B;font-weight:700}
  #yday-hours{max-height:190px}
</style>
